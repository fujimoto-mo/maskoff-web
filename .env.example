# ============================================================
# ローカル開発用。コピーして .env.local を作る（WSL 内で作成し BOM を避ける）。
#
# 本番（Cloudflare Pages）の値は 3 か所に分かれる:
#   1. wrangler.toml [vars]              非機密・Function 実行時（MAINTENANCE / NEXT_PUBLIC_SITE_URL / CONTACT_*）
#   2. Pages ダッシュボード 暗号化変数    機密・Function 実行時（下記「実行時の機密」。Production / Preview 両方）
#   3. Pages ダッシュボード ビルド用変数  ビルド時（下記「ビルド時」。Production / Preview 両方）
#
# .env.local は絶対にコミットしないこと。
# ============================================================

# --- ビルド時（next build）-------------------------------------
# 正規 URL。canonical / OGP / sitemap がこれに追従する。検証中は https://<project>.pages.dev、本番切替後は https://maskoff.co.jp に変更して再ビルド
NEXT_PUBLIC_SITE_URL="https://maskoff.co.jp"
# microCMS（Hobby / API上限5本 / 転送量20GB per月）。未設定なら src/content/sample.ts のサンプルでビルドされる
MICROCMS_SERVICE_DOMAIN=""
MICROCMS_API_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Pages のビルド環境の Node バージョン（.node-version と同じ値）
NODE_VERSION="24.17.0"

# --- Function 実行時の機密（wrangler pages dev は .dev.vars を読む。.dev.vars.example 参照）---
# RESEND_API_KEY / TURNSTILE_SECRET_KEY / MICROCMS_WEBHOOK_SECRET / CF_DEPLOY_HOOK_URL / SLACK_WEBHOOK_URL（任意）
