# ============================================================
# ローカル開発用。コピーして .env.local を作る。
#
# 本番の値は3か所に分かれる（docs/setup-workers.md 参照）:
#   1. wrangler.toml [vars]     非機密・Worker実行時
#   2. wrangler secret put       機密・Worker実行時
#   3. GitHub Actions Secrets    ビルド時
#
# .env.local は絶対にコミットしないこと。
# ============================================================

# --- ビルド時に使う ------------------------------------------
SITE_URL="https://maskoff.co.jp"
NEXT_PUBLIC_SITE_URL="https://maskoff.co.jp"

# microCMS（Hobby / API上限5本 / 転送量20GB per月）
# 画像は直接配信せず、ビルド時に取得して public/ へ同梱する
MICROCMS_SERVICE_DOMAIN=""
MICROCMS_API_KEY=""

NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# --- Worker 実行時に使う（wrangler dev 用） -------------------
# 本番では wrangler secret put で登録する
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="noreply@maskoff.co.jp"
CONTACT_TO_EMAIL="info@maskoff.co.jp"
TURNSTILE_SECRET_KEY=""
MICROCMS_WEBHOOK_SECRET=""
GITHUB_REPO="owner/maskoff-web"
GITHUB_DISPATCH_TOKEN=""
SLACK_WEBHOOK_URL=""
