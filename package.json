{
  "name": "maskoff-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fetch-cms-images.mjs",
    "dev": "next dev",
    "build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fetch-cms-images.mjs && next build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-worker.mjs",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\" \"worker/**/*.test.ts\"",
    "images": "node scripts/optimize-images.mjs",
    "assets:sample": "node scripts/gen-sample-assets.mjs",
    "preview": "npm run build && wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.127.1"
  }
}
