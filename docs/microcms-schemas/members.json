{
  "apiName": "members",
  "apiType": "list",
  "description": "所属アーティスト・社員紹介。参考サイトのCREATORSに相当",
  "apiFields": [
    { "fieldId": "name", "name": "名前", "kind": "text", "required": true },
    { "fieldId": "slug", "name": "スラッグ", "kind": "text", "required": true },
    { "fieldId": "role", "name": "肩書", "kind": "text", "required": true, "description": "例: グラフィックデザイナー・アーティスト" },
    { "fieldId": "avatar", "name": "アバター", "kind": "media", "required": true, "description": "正方形。512x512 以上" },
    { "fieldId": "bio", "name": "紹介文", "kind": "textArea", "required": true, "description": "80〜140字。長すぎるとレイアウトが崩れます" },
    { "fieldId": "markerPhrases", "name": "マーカー強調する語句", "kind": "text", "required": false, "description": "カンマ区切り。紹介文中の該当箇所に緑マーカーが入ります。2〜3語まで" },
    { "fieldId": "worksImages", "name": "コラージュ用作品画像", "kind": "mediaList", "required": false, "description": "3〜5枚。スクロール時に周囲へ不規則配置されます" },
    { "fieldId": "instagram", "name": "Instagram ID", "kind": "text", "required": false, "description": "@ は不要" },
    { "fieldId": "externalUrl", "name": "外部リンク", "kind": "text", "required": false },
    { "fieldId": "order", "name": "表示順", "kind": "number", "required": true, "description": "小さい順に表示" }
  ]
}
